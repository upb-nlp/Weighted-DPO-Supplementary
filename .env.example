# Copy to .env and fill in. Never commit the filled-in file.

# Hugging Face token, for the base model and the preference dataset.
HF_TOKEN=

# Optional: cache locations. Compute nodes without outbound network access need
# these pre-populated from a login node.
# HF_HOME=
# TIKTOKEN_CACHE_DIR=

# Optional: Weights & Biases. Set WANDB_MODE=disabled to turn logging off.
# WANDB_MODE=disabled
# WANDB_PROJECT=weighted-dpo
